---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Wat doen ze daar?">
  <main class="min-h-dvh bg-slate-50">
    <section class="mx-auto flex min-h-dvh w-full max-w-3xl flex-col px-4 py-5 sm:px-6 sm:py-8">
      <header class="mb-5 sm:mb-7">
        <p class="text-sm font-medium text-slate-500">Wat doen ze daar?</p>
        <h1 class="mt-2 text-3xl font-semibold tracking-normal text-slate-950 sm:text-5xl">
          Zoek in de Tweede Kamer
        </h1>
      </header>

      <form id="search-form" class="sticky top-0 z-10 -mx-4 bg-slate-50/95 px-4 py-3 backdrop-blur sm:static sm:mx-0 sm:bg-transparent sm:px-0 sm:py-0">
        <label for="search-input" class="sr-only">Zoeken</label>
        <div class="flex min-h-14 items-center gap-2 rounded-lg border border-slate-300 bg-white px-3 shadow-sm focus-within:border-slate-950 focus-within:ring-2 focus-within:ring-slate-950/10">
          <svg class="h-5 w-5 flex-none text-slate-500" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="m21 21-4.3-4.3m1.8-5.2a7 7 0 1 1-14 0 7 7 0 0 1 14 0Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
          </svg>
          <input
            id="search-input"
            name="q"
            type="search"
            inputmode="search"
            autocomplete="off"
            placeholder="Zoek op onderwerp, persoon of document"
            class="min-w-0 flex-1 bg-transparent py-4 text-base text-slate-950 outline-none placeholder:text-slate-400"
          />
          <button
            type="submit"
            class="flex-none rounded-md bg-slate-950 px-4 py-2.5 text-sm font-semibold text-white transition active:scale-[0.98] disabled:cursor-not-allowed disabled:bg-slate-300"
          >
            Zoek
          </button>
        </div>
      </form>

      <div id="status" class="min-h-12 py-4 text-sm text-slate-600" role="status" aria-live="polite">
        Typ een zoekterm om resultaten te zien.
      </div>

      <ol id="results" class="grid gap-3 pb-8"></ol>
    </section>
  </main>
</BaseLayout>

<script>
  const API_BASE_URL = "https://api.watdoenzedaar.nl";
  const form = document.querySelector<HTMLFormElement>("#search-form");
  const input = document.querySelector<HTMLInputElement>("#search-input");
  const status = document.querySelector<HTMLDivElement>("#status");
  const results = document.querySelector<HTMLOListElement>("#results");

  type SearchResult = {
    key: string;
    source_category: string;
    entity_kind: string;
    title: string;
    summary: string | null;
    source_url: string | null;
    api_url: string;
    date: string | null;
    document_number: string | null;
    snippets: Array<{ field: string; text: string; highlighted: string | null }>;
  };

  type SearchResponse = {
    query: string;
    estimated_total_hits: number | null;
    items: SearchResult[];
  };

  type SearchRestoreState = {
    query: string;
    scrollY: number;
  };

  type HistoryState = Record<string, unknown> & {
    searchRestore?: SearchRestoreState;
  };

  let activeRequest: AbortController | null = null;
  let restoreAfterNextRender = false;

  const initialQuery = new URL(window.location.href).searchParams.get("q") ?? "";
  if (input && initialQuery) {
    input.value = initialQuery;
    restoreAfterNextRender = hasMatchingRestoreState(initialQuery);
    void runSearch(initialQuery, { updateUrl: false });
  }

  form?.addEventListener("submit", (event) => {
    event.preventDefault();
    void runSearch(input?.value ?? "");
  });

  input?.addEventListener("input", () => {
    const query = input.value.trim();
    window.clearTimeout(Number(input.dataset.timer));
    input.dataset.timer = window.setTimeout(() => {
      void runSearch(query);
    }, 250).toString();
  });

  results?.addEventListener("click", (event) => {
    const target = event.target;
    if (!(target instanceof Element) || !target.closest("a")) {
      return;
    }

    saveSearchScrollState();
  });

  document.addEventListener("astro:before-preparation", saveSearchScrollState);
  window.addEventListener("pagehide", saveSearchScrollState);

  async function runSearch(rawQuery: string, options: { updateUrl?: boolean } = {}) {
    const query = rawQuery.trim();
    if (!status || !results) {
      throw new Error("Search UI is missing required status or results elements.");
    }

    activeRequest?.abort();
    results.replaceChildren();
    updateQueryUrl(query, options.updateUrl ?? true);

    if (!query) {
      status.textContent = "Typ een zoekterm om resultaten te zien.";
      return;
    }

    const request = new AbortController();
    activeRequest = request;
    status.textContent = "Zoeken...";

    try {
      const url = new URL("/search", API_BASE_URL);
      url.searchParams.set("q", query);
      url.searchParams.set("limit", "20");

      const response = await fetch(url, {
        headers: { Accept: "application/json" },
        signal: request.signal,
      });

      if (!response.ok) {
        throw new Error(`Search failed with HTTP ${response.status}`);
      }

      const data = (await response.json()) as SearchResponse;
      if (request.signal.aborted) {
        return;
      }

      renderResults(data);
    } catch (error) {
      if (request.signal.aborted) {
        return;
      }
      console.error(error);
      status.textContent = "Zoeken lukt nu niet. Probeer het later opnieuw.";
    }
  }

  function renderResults(data: SearchResponse) {
    if (!status || !results) {
      return;
    }

    if (data.items.length === 0) {
      status.textContent = `Geen resultaten voor "${data.query}".`;
      return;
    }

    const count = data.estimated_total_hits ?? data.items.length;
    status.textContent = `${count} resultaat${count === 1 ? "" : "en"} voor "${data.query}".`;
    results.replaceChildren(...data.items.map(renderResult));
    restoreScrollIfNeeded(data.query);
  }

  function renderResult(item: SearchResult) {
    const result = document.createElement("li");
    result.className = "rounded-lg border border-slate-200 bg-white p-4 shadow-sm";

    const meta = document.createElement("div");
    meta.className = "mb-2 flex flex-wrap items-center gap-x-2 gap-y-1 text-xs font-medium text-slate-500";
    meta.append(createPill(item.entity_kind), document.createTextNode(item.source_category));

    if (item.document_number) {
      meta.append(document.createTextNode(`Nr. ${item.document_number}`));
    }

    const title = document.createElement("h2");
    title.className = "text-lg font-semibold leading-snug text-slate-950";

    const link = document.createElement("a");
    link.className = "outline-none hover:underline focus:underline";
    link.href = item.source_url ?? `${API_BASE_URL}${item.api_url}`;
    link.textContent = item.title;
    title.append(link);

    const summary = document.createElement("p");
    summary.className = "mt-2 text-sm leading-6 text-slate-700";
    summary.textContent = item.summary ?? bestSnippetText(item) ?? "Geen samenvatting beschikbaar.";

    const footer = document.createElement("div");
    footer.className = "mt-3 flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-slate-500";

    if (item.date) {
      const date = document.createElement("time");
      date.dateTime = item.date;
      date.textContent = formatDate(item.date);
      footer.append(date);
    }

    const apiLink = document.createElement("a");
    apiLink.className = "font-medium text-slate-700 underline underline-offset-2";
    apiLink.href = `${API_BASE_URL}${item.api_url}`;
    apiLink.textContent = "API";
    footer.append(apiLink);

    result.append(meta, title, summary, footer);
    return result;
  }

  function createPill(text: string) {
    const pill = document.createElement("span");
    pill.className = "rounded bg-slate-100 px-2 py-1 text-slate-700";
    pill.textContent = text;
    return pill;
  }

  function bestSnippetText(item: SearchResult) {
    return item.snippets.find((snippet) => snippet.text.trim().length > 0)?.text ?? null;
  }

  function formatDate(value: string) {
    const date = new Date(value);
    if (Number.isNaN(date.getTime())) {
      return value;
    }
    return new Intl.DateTimeFormat("nl-NL", {
      day: "numeric",
      month: "short",
      year: "numeric",
    }).format(date);
  }

  function updateQueryUrl(query: string, shouldUpdate: boolean) {
    if (!shouldUpdate) {
      return;
    }

    const url = new URL(window.location.href);
    if (query) {
      url.searchParams.set("q", query);
    } else {
      url.searchParams.delete("q");
    }

    const currentState = getHistoryState();
    const restoreState = currentState.searchRestore?.query === query ? currentState.searchRestore : undefined;
    const nextState = {
      ...currentState,
      searchRestore: restoreState,
    };

    history.replaceState(nextState, "", `${url.pathname}${url.search}${url.hash}`);
  }

  function saveSearchScrollState() {
    const query = input?.value.trim() ?? "";
    if (!query) {
      return;
    }

    history.replaceState(
      {
        ...getHistoryState(),
        searchRestore: {
          query,
          scrollY: window.scrollY,
        },
      },
      "",
      window.location.href,
    );
  }

  function restoreScrollIfNeeded(query: string) {
    if (!restoreAfterNextRender) {
      return;
    }

    restoreAfterNextRender = false;
    const restoreState = getHistoryState().searchRestore;
    if (restoreState?.query !== query) {
      return;
    }

    requestAnimationFrame(() => {
      window.scrollTo({ top: restoreState.scrollY, left: 0, behavior: "instant" });
    });
  }

  function hasMatchingRestoreState(query: string) {
    return getHistoryState().searchRestore?.query === query;
  }

  function getHistoryState(): HistoryState {
    if (history.state && typeof history.state === "object") {
      return history.state as HistoryState;
    }

    return {};
  }
</script>
