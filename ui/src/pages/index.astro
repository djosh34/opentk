---
import AppShell from "../components/AppShell.astro";
import SearchForm from "../components/SearchForm.astro";
import StatusLine from "../components/StatusLine.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const initialQuery = Astro.url.searchParams.get("q") ?? "";
---

<BaseLayout title="Zoek in de Tweede Kamer">
  <AppShell title="Zoek in de Tweede Kamer">
    <SearchForm initialQuery={initialQuery} />
    <StatusLine />
    <ol id="results" class="grid gap-3 pb-10"></ol>
  </AppShell>
</BaseLayout>

<script>
  import "../scripts/search-page";
</script>
