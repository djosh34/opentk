---
interface Props {
  initialQuery?: string;
  sticky?: boolean;
}

const { initialQuery = "", sticky = true } = Astro.props;
---

<form
  id="search-form"
  action="/"
  class:list={[
    "z-10 bg-[#f6f7f3]/95 py-3 backdrop-blur sm:bg-transparent sm:py-0",
    sticky && "sticky top-0 -mx-4 px-4 sm:static sm:mx-0 sm:px-0",
  ]}
>
  <label for="search-input" class="sr-only">Zoeken</label>
  <div class="flex min-h-16 items-center gap-2 rounded-lg border border-stone-300 bg-white px-3 shadow-sm shadow-stone-950/5 focus-within:border-stone-950 focus-within:ring-3 focus-within:ring-lime-700/15">
    <svg class="h-5 w-5 flex-none text-stone-500" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path d="m21 21-4.3-4.3m1.8-5.2a7 7 0 1 1-14 0 7 7 0 0 1 14 0Z" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
    </svg>
    <input
      id="search-input"
      name="q"
      type="search"
      inputmode="search"
      autocomplete="off"
      value={initialQuery}
      placeholder="Zoek op onderwerp, persoon of document"
      class="min-w-0 flex-1 bg-transparent py-4 text-base text-stone-950 outline-none placeholder:text-stone-400"
    />
    <button
      type="submit"
      class="flex-none rounded-md bg-stone-950 px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-lime-800 active:scale-[0.98] disabled:cursor-not-allowed disabled:bg-stone-300"
    >
      Zoek
    </button>
  </div>
</form>
