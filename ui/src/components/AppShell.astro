---
interface Props {
  eyebrow?: string;
  title: string;
  maxWidth?: "normal" | "wide";
}

const { eyebrow = "Wat doen ze daar?", title, maxWidth = "normal" } = Astro.props;
const widthClass = maxWidth === "wide" ? "max-w-6xl" : "max-w-4xl";
---

<main class="min-h-dvh bg-[#f6f7f3]">
  <section class:list={["mx-auto flex min-h-dvh w-full flex-col px-4 py-5 sm:px-6 sm:py-8", widthClass]}>
    <header class="mb-6 sm:mb-8">
      <a href="/" class="text-sm font-semibold text-stone-500 transition hover:text-stone-950">{eyebrow}</a>
      <h1 class="mt-2 max-w-3xl text-3xl font-semibold tracking-normal text-stone-950 sm:text-5xl">
        {title}
      </h1>
    </header>

    <slot />
  </section>
</main>
