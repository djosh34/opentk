# syntax=docker/dockerfile:1.7

ARG ARTIFACT_IMAGE=opentk-scratch-artifacts:local
FROM --platform=${BUILDPLATFORM} ${ARTIFACT_IMAGE} AS artifacts

FROM artifacts AS artifact-selector

ARG BINARY
ARG TARGETARCH

RUN case "${BINARY}" in \
        opentk-sync|opentk-api) ;; \
        *) echo "unsupported BINARY: ${BINARY}" >&2; exit 1 ;; \
    esac \
    && case "${TARGETARCH}" in \
        amd64) rust_target="x86_64-unknown-linux-musl" ;; \
        arm64) rust_target="aarch64-unknown-linux-musl" ;; \
        *) echo "unsupported Docker TARGETARCH: ${TARGETARCH}" >&2; exit 1 ;; \
    esac \
    && test -x "/artifacts/${rust_target}/${BINARY}" \
    && mkdir -p /runtime/bin \
    && cp "/artifacts/${rust_target}/${BINARY}" /runtime/bin/opentk

FROM scratch

COPY --from=artifact-selector /runtime/ /

USER 1000:1000
ENTRYPOINT ["/bin/opentk"]
