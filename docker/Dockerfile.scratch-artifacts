# syntax=docker/dockerfile:1.7

FROM --platform=${BUILDPLATFORM} rust:1-bookworm AS builder

RUN dpkg --add-architecture amd64 \
    && apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates clang lld musl-dev:amd64 musl-tools pkg-config \
    && rm -rf /var/lib/apt/lists/* \
    && rustup target add x86_64-unknown-linux-musl aarch64-unknown-linux-musl

ENV CC_x86_64_unknown_linux_musl=clang \
    CFLAGS_x86_64_unknown_linux_musl="--target=x86_64-unknown-linux-musl -isystem /usr/include/x86_64-linux-musl" \
    AR_x86_64_unknown_linux_musl=x86_64-linux-gnu-ar \
    CC_aarch64_unknown_linux_musl=clang \
    CFLAGS_aarch64_unknown_linux_musl="--target=aarch64-unknown-linux-musl -isystem /usr/include/aarch64-linux-musl" \
    AR_aarch64_unknown_linux_musl=ar

WORKDIR /workspace

COPY Cargo.toml Cargo.lock ./
COPY .cargo .cargo
COPY crates/opentk-api/Cargo.toml crates/opentk-api/Cargo.toml
COPY crates/opentk-config/Cargo.toml crates/opentk-config/Cargo.toml
COPY crates/opentk-core/Cargo.toml crates/opentk-core/Cargo.toml
COPY crates/opentk-db/Cargo.toml crates/opentk-db/Cargo.toml
COPY crates/opentk-search/Cargo.toml crates/opentk-search/Cargo.toml
COPY crates/opentk-search-eval/Cargo.toml crates/opentk-search-eval/Cargo.toml
COPY crates/opentk-sync/Cargo.toml crates/opentk-sync/Cargo.toml

RUN mkdir -p \
        crates/opentk-api/src/bin \
        crates/opentk-config/src \
        crates/opentk-core/src \
        crates/opentk-db/src/bin \
        crates/opentk-search/src \
        crates/opentk-search-eval/src/bin \
        crates/opentk-sync/src/bin \
    && for crate in opentk-api opentk-config opentk-core opentk-db opentk-search opentk-search-eval opentk-sync; do \
        printf 'pub fn dependency_cache_placeholder() {}\n' > "crates/${crate}/src/lib.rs"; \
    done \
    && printf 'fn main() {}\n' > crates/opentk-api/src/bin/opentk-api.rs \
    && printf 'fn main() {}\n' > crates/opentk-db/src/bin/opentk-sync.rs \
    && printf 'fn main() {}\n' > crates/opentk-search-eval/src/bin/search-eval.rs \
    && printf 'fn main() {}\n' > crates/opentk-sync/src/bin/official-schema.rs

RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/usr/local/cargo/git \
    --mount=type=cache,id=opentk-scratch-target,target=/workspace/target \
    cargo build --release --target x86_64-unknown-linux-musl -p opentk-db -p opentk-api --bin opentk-sync --bin opentk-api \
    && cargo build --release --target aarch64-unknown-linux-musl -p opentk-db -p opentk-api --bin opentk-sync --bin opentk-api

COPY crates crates
COPY migrations migrations

RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/usr/local/cargo/git \
    --mount=type=cache,id=opentk-scratch-target,target=/workspace/target \
    cargo build --release --target x86_64-unknown-linux-musl -p opentk-db -p opentk-api --bin opentk-sync --bin opentk-api \
    && cargo build --release --target aarch64-unknown-linux-musl -p opentk-db -p opentk-api --bin opentk-sync --bin opentk-api \
    && mkdir -p \
        /artifacts/x86_64-unknown-linux-musl \
        /artifacts/aarch64-unknown-linux-musl \
        /runtime/etc \
    && cp /workspace/target/x86_64-unknown-linux-musl/release/opentk-sync /artifacts/x86_64-unknown-linux-musl/opentk-sync \
    && cp /workspace/target/x86_64-unknown-linux-musl/release/opentk-api /artifacts/x86_64-unknown-linux-musl/opentk-api \
    && cp /workspace/target/aarch64-unknown-linux-musl/release/opentk-sync /artifacts/aarch64-unknown-linux-musl/opentk-sync \
    && cp /workspace/target/aarch64-unknown-linux-musl/release/opentk-api /artifacts/aarch64-unknown-linux-musl/opentk-api \
    && cp /etc/ssl/certs/ca-certificates.crt /runtime/etc/ca-certificates.crt \
    && printf 'opentk:x:1000:1000:opentk:/nonexistent:/sbin/nologin\n' > /runtime/etc/passwd \
    && printf 'opentk:x:1000:\n' > /runtime/etc/group
